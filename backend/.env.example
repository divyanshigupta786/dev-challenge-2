# Mundane Backend Configuration

# Server
HOST=127.0.0.1
PORT=8000

# CORS (Frontend Origins)
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:4173","http://127.0.0.1:5173"]

# AI Provider selector: "groq" (cloud) or "ollama" (local)
AI_PROVIDER=groq

# Groq Cloud AI Configuration (Get free key at https://console.groq.com)
GROQ_API_KEY=gsk_your_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Ollama Local AI Configuration (Used if AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=60
